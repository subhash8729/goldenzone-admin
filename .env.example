# =======================================================
# Golden Zone Admin Portal — Environment Configuration
# =======================================================

# Backend API Base URL
# - In local development with Vite proxy, leave empty (defaults to '/api' proxied to port 5000)
# - In production deployment on a separate admin domain (e.g. https://admin.goldenzone.in), set your backend API URL:
#   VITE_API_URL=https://goldenzone.in/api
VITE_API_URL=

# Public storefront URL used by the "View Live Storefront" link in the admin portal.
# Set this for a separately deployed production admin app.
VITE_STOREFRONT_URL=
